{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -File .\\scripts\\emit-1234.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -File .\\scripts\\emit-1234.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ],

    "PostToolUse": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -File .\\scripts\\report-tool-error.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ]
  }
}
