{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\validate-tool.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\emit-1234.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\emit-1234.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ],

    "PostToolUse": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\report-tool-error.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ]
  }
}
