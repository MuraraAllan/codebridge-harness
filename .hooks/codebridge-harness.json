{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emit-reasoning-proof.js",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\validate-tool.js",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emit-commit-context.js",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emit-reasoning-proof.js",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\injectContextImageInterpret.js",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\injectContextUserinstructions.js",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\report-tool-error.js",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emit-changes-digraph-node.js",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
