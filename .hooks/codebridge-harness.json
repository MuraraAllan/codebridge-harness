{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emitReasoningProof.js",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\validateTool.js",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emitCommitContext.js",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emitReasoningProof.js",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\injectContextImageInterpret.js",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\injectContextUserinstructions.js",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\reportToolError.js",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node .\\mcp-server\\src\\hooks\\emitChangesDigraphNode.js",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
