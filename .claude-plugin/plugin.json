{
  "name": "codebridge-harness",
  "version": "1.0.0",
  "description": "Claude-compatible adapter for the shared Codebridge React Router harness plugin.",
  "mcpServers": {
    "codebridge-harness": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}\\scripts\\windows\\serve-harness-mcp.ps1"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
