{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\emit-reasoning-proof.ps1",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\validate-tool.ps1",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\emit-commit-context.ps1",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\emit-reasoning-proof.ps1",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      },
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\inject-context-image-interpret.ps1",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      },
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\inject-context-userinstructions.ps1",
        "cwd": ".",
        "injectAsContext": true,
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\report-tool-error.ps1",
        "cwd": ".",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\windows\\emit-changes-digraph-node.ps1",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
