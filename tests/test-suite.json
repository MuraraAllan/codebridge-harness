{
  "suiteName": "Codebridge React Router Harness",
  "tests": [
    {
      "id": "inject-session-context",
      "hookScript": "..\\scripts\\windows\\emit-1234.ps1",
      "input": {
        "hook_event_name": "SessionStart"
      },
      "expected": {
        "hookEventName": "SessionStart",
        "additionalContext": "1234"
      }
    },
    {
      "id": "notify-on-user-prompt",
      "hookScript": "..\\scripts\\windows\\emit-1234.ps1",
      "input": {
        "hook_event_name": "UserPromptSubmit",
        "prompt": "Run the hook harness."
      },
      "expected": {
        "systemMessage": "1234"
      }
    },
    {
      "id": "request-error-report-after-failed-tool",
      "hookScript": "..\\scripts\\windows\\report-tool-error.ps1",
      "input": {
        "hook_event_name": "PostToolUse",
        "tool_name": "runTerminalCommand",
        "tool_response": "Error: Access denied."
      },
      "expected": {
        "hookEventName": "PostToolUse",
        "additionalContext": "userIntervention tool error"
      }
    },
    {
      "id": "ask-before-destructive-command",
      "input": {
        "tool_name": "run_in_terminal",
        "tool_input": {
          "command": "rm -rf /"
        }
      },
      "expected": {
        "permissionDecision": "ask",
        "reasonContains": "requires manual confirmation"
      }
    },
    {
      "id": "ask-sensitive-file-edit",
      "input": {
        "tool_name": "edit_file",
        "tool_input": {
          "filePath": ".env",
          "content": "API_KEY=secret"
        }
      },
      "expected": {
        "permissionDecision": "ask",
        "reasonContains": "requires manual confirmation"
      }
    },
    {
      "id": "allow-safe-command",
      "input": {
        "tool_name": "run_in_terminal",
        "tool_input": {
          "command": "npm test"
        }
      },
      "expected": {
        "permissionDecision": "allow"
      }
    },
    {
      "id": "ask-before-vscode-destructive-command",
      "input": {
        "tool_name": "runTerminalCommand",
        "tool_input": {
          "command": "git push --force origin main"
        }
      },
      "expected": {
        "permissionDecision": "ask",
        "reasonContains": "requires manual confirmation"
      }
    },
    {
      "id": "ask-vscode-sensitive-file-edit",
      "input": {
        "tool_name": "editFiles",
        "tool_input": {
          "files": ["config\\prod.json"]
        }
      },
      "expected": {
        "permissionDecision": "ask",
        "reasonContains": "requires manual confirmation"
      }
    }
  ]
}
